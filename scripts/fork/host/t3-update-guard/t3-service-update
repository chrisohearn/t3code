#!/bin/sh
# The supported way to change the T3 Code background service on this machine.
# Installs the newest verified fork release (or the version given), checks that it serves,
# and rolls back if it does not. Waits for running threads unless --now is given.
#   t3-service-update [--now] [version]
#   t3-service-update status
#   t3-service-update resume     lift an automatic-updates hold once its cause is fixed
case "${1:-}" in
  status) exec "$HOME/.local/libexec/t3-update-guard/guard" status ;;
  resume) exec "$HOME/.local/libexec/t3-update-guard/guard" resume ;;
esac
exec "$HOME/.local/libexec/t3-update-guard/guard" update "$@"
